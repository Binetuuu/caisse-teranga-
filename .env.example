# Copiez ce fichier en .env puis adaptez. Ne versionnez JAMAIS .env.

# demo | production   (production : SECRET_KEY obligatoire, portefeuille factice interdit, cookies Secure)
APP_ENV=demo

# Clé maîtresse (chiffrement + empreintes). Générez-la avec :
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRET_KEY=

# --- Lightning ---------------------------------------------------------------
# fake   : factures BOLT11 réelles mais réseau de test, paiement simulé (démo)
# lnbits : vrai service Lightning via LNbits
LIGHTNING_BACKEND=fake
# URL de votre LNbits (https obligatoire, sauf réseau Docker privé avec LNBITS_ALLOW_HTTP=true)
LNBITS_URL=
# Clé « Invoice/read » du portefeuille par défaut. JAMAIS la clé Admin.
LNBITS_INVOICE_KEY=
LNBITS_ALLOW_HTTP=false

# --- Encaissement -------------------------------------------------------------
MIN_AMOUNT_XOF=100
MAX_AMOUNT_XOF=500000
INVOICE_EXPIRY_SECONDS=600
# coingecko (taux en direct, secours sur BTC_XOF_STATIC) | static
RATE_SOURCE=coingecko
BTC_XOF_STATIC=62500000

# --- IA (optionnel) -----------------------------------------------------------
# Sans clé, résumés et assistante fonctionnent avec des textes locaux.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Retrait Mobile Money -----------------------------------------------------
# Frais en points de base (100 = 1 %) et plafond quotidien par commerçant.
PAYOUT_FEE_BPS=100
PAYOUT_DAILY_MAX_XOF=300000

# --- Divers -------------------------------------------------------------------
SEED_DEMO=true
SUPPORT_PHONE=
# Jeton pour /api/metrics (indicateurs agrégés). Vide = désactivé.
METRICS_TOKEN=
# true derrière HTTPS (obligatoire en production)
COOKIE_SECURE=false
BIND_ADDR=127.0.0.1
PORT=8000
